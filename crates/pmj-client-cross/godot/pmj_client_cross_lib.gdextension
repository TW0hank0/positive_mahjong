linux.release.arm64 =   "res://../../../target/aarch64-unknown-linux-musl/release/libpmj_client_cross_lib.so"
windows.debug.x86_64 =   "res://../../../target/x86_64-pc-windows-msvc/debug/libpmj_client_cross_lib.dll"
windows.release.x86_64 = "res://../target/x86_64-pc-windows-msvc/release/libpmj_client_cross_lib.dll"
windows.debug.arm64 =   "res://../../../target/aarch64-pc-windows-msvc/debug/libpmj_client_cross_lib.dll"
windows.release.arm64 = "res://../target/aarch64-pc-windows-msvc/release/libpmj_client_cross_lib.dll"
; macos.debug =            "res://../rust/target/debug/libpmj_client_cross_lib.dylib"
; macos.release =          "res://../rust/target/release/libpmj_client_cross_lib.dylib"
; macos.debug.arm64 =      "res://../rust/target/debug/libpmj_client_cross_lib.dylib"
; macos.release.arm64 =    "res://../rust/target/release/libpmj_client_cross_lib.dylib"
android.debug.arm64 = "res://../../../target/aarch64-linux-android/debug/libpmj_client_cross_lib.so"
android.release.arm64 = "res://../../../target/aarch64-linux-android/release/libpmj_client_cross_lib.so"
android.debug.x86_64 = "res://../../../target/x86_64-linux-android/debug/libpmj_client_cross_lib.so"
android.release.x86_64 = "res://../../../target/x86_64-linux-android/release/libpmj_client_cross_lib.so"
