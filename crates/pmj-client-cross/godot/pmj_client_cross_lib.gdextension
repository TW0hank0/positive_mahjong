[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../../../target/x86_64-unknown-linux-musl/debug/libpmj_client_cross_lib.so"
