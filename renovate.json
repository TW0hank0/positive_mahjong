{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"automerge": false,
	"labels": ["it-is::dep-update"],
	"customManagers": [
		{
			"description": "Monitor cargo tools versions in ci-cache-version.json",
			"customType": "regex",
			"managerFilePatterns": ["/^ci-cache-version\\.json$/"],
			"matchStrings": [
	    		"\"(?<depName>[a-z0-9-]+)\":\\s*\"(?<currentValue>[\\d\\.]+)\""
			],
			"datasourceTemplate": "crate",
			"versioningTemplate": "semver"
		}
																																		],
																																										"packageRules": [
																																												{
																																																		"automerge": false,
																																															"matchPackageNames": [
																																																"*"
																																														]
																																																				},
																																																						{
																																																									"description": "將所有未鎖定或萬用字元版本釘選到具體版本",
																																																															"rangeStrategy": "pin",
																																																									"matchPackageNames": [
																																																																														"*"
																																																																		]
																																																																	}
																																																																		],
																																																																			"timezone": "Asia/Taipei"}
